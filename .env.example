APP_NAME=Zero Trust Architecture Simulator
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./zero_trust.db
JWT_SECRET_KEY=change-this-secret-before-running
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
RISK_THRESHOLD=70
REQUIRE_TRUSTED_DEVICE_FOR_HIGH_SENSITIVITY=true
REQUIRE_MFA_FOR_HIGH_SENSITIVITY=false
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
